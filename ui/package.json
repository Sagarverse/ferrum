{
  "name": "ferrum",
  "version": "0.1.0",
  "description": "Ferrum — Professional Data Protection Platform",
  "main": "electron/main.js",
  "author": "Ferrum",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "app:pack": "vite build && electron-builder --mac --dir",
    "app:build": "vite build && electron-builder --mac",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.metallicmind.app",
    "productName": "Ferrum",
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": ["nsis"]
    },
    "extraResources": [
      {
        "from": "../core/target/release/ferrum",
        "to": "bin/ferrum"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.1.2",
    "electron": "^36.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.3"
  }
}
